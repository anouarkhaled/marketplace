# Optional local Docker Compose overrides. Copy to .env to customize.
# The defaults in compose.yaml already run at http://localhost:8080.
APP_PORT=8080
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace-local-only
DJANGO_SECRET_KEY=docker-local-only-marketplace-secret-change-before-deployment-2026

# Local HTTP: False. Set True when serving the app through HTTPS.
COOKIE_SECURE=False

# Emails are printed to backend logs by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@marketplace.local

# To send actual emails, configure your provider here and select SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
